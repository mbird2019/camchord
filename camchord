#!/usr/bin/env bash
# Run CamChord straight from a checkout. The first run sets itself up in ./.venv.
#
#   ./camchord               start the window (sets up first if needed)
#   ./camchord --install     also add a launcher to ~/.local/bin and a menu entry
#   ./camchord --uninstall   remove those two again
#   ./camchord doctor        check this computer and say what to fix
# Any other arguments go to CamChord itself (cameras, ctl ..., --help).
set -eu

HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
VENV="$HERE/.venv"
STAMP="$VENV/.camchord-setup"

say() { printf 'camchord: %s\n' "$*" >&2; }
die() { say "$*"; exit 1; }

find_python() {
    local candidate
    for candidate in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
        if command -v "$candidate" >/dev/null 2>&1 &&
            "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
            command -v "$candidate"
            return 0
        fi
    done
    return 1
}

setup() {
    local py
    py=$(find_python) || die "Python 3.10 or newer is needed (Debian/Ubuntu: sudo apt install python3 python3-venv; Fedora: sudo dnf install python3)."
    if [ ! -x "$VENV/bin/python" ]; then
        say "first run: setting up in $VENV (downloads Qt, about 200 MB, once)"
        if ! "$py" -m venv "$VENV"; then
            rm -rf "$VENV"
            die "could not create a virtual environment (Debian/Ubuntu: sudo apt install python3-venv)."
        fi
    else
        say "updating the installed dependencies"
    fi
    if "$VENV/bin/python" -m pip --version >/dev/null 2>&1; then
        "$VENV/bin/python" -m pip install --disable-pip-version-check -e "$HERE" ||
            die "pip could not install CamChord (is the computer online?)."
    elif command -v uv >/dev/null 2>&1; then
        uv pip install -p "$VENV/bin/python" -e "$HERE" || die "uv could not install CamChord."
    else
        "$VENV/bin/python" -m ensurepip --upgrade >/dev/null 2>&1 || die "pip is missing from $VENV; delete that folder and run again."
        "$VENV/bin/python" -m pip install --disable-pip-version-check -e "$HERE" || die "pip could not install CamChord."
    fi
    cksum < "$HERE/pyproject.toml" > "$STAMP"
    command -v ffmpeg >/dev/null 2>&1 ||
        say "ffmpeg is not installed, and CamChord needs it (Debian/Ubuntu: sudo apt install ffmpeg; Fedora: sudo dnf install ffmpeg-free; Arch: sudo pacman -S ffmpeg)."
}

ready() {
    [ -x "$VENV/bin/camchord" ] && [ -f "$STAMP" ] && [ "$(cksum < "$HERE/pyproject.toml")" = "$(cat "$STAMP")" ]
}

install_launcher() {
    local bin="${XDG_BIN_HOME:-$HOME/.local/bin}" data="${XDG_DATA_HOME:-$HOME/.local/share}"
    mkdir -p "$bin" "$data/applications" "$data/icons/hicolor/scalable/apps"
    ln -sf "$HERE/camchord" "$bin/camchord"
    sed "s|^Exec=.*|Exec=$HERE/camchord|" "$HERE/data/camchord.desktop" > "$data/applications/camchord.desktop"
    cp "$HERE/data/camchord.svg" "$data/icons/hicolor/scalable/apps/camchord.svg"
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$data/applications" >/dev/null 2>&1 || true
    say "installed: $bin/camchord and a CamChord entry in the application menu"
    case ":$PATH:" in *":$bin:"*) ;; *) say "note: $bin is not on your PATH; add it to type just 'camchord'" ;; esac
}

uninstall_launcher() {
    local bin="${XDG_BIN_HOME:-$HOME/.local/bin}" data="${XDG_DATA_HOME:-$HOME/.local/share}"
    rm -f "$bin/camchord" "$data/applications/camchord.desktop" "$data/icons/hicolor/scalable/apps/camchord.svg"
    say "removed the launcher and menu entry (this folder and ./.venv are left alone)"
}

case "${1:-}" in
    --uninstall) uninstall_launcher; exit 0 ;;
esac

ready || setup

case "${1:-}" in
    --install) install_launcher; exit 0 ;;
esac

exec "$VENV/bin/camchord" "$@"
